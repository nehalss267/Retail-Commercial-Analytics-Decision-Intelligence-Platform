 "cells": [
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": ["# 03 — Customer Analytics\n", "RFM segmentation, customer clustering, and segment profiling."]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": ["import pandas as pd\n", "import numpy as np\n", "import plotly.express as px\n", "from pathlib import Path\n", "\n", "FEATURES = Path('..') / 'data' / 'features'\n", "rfm = pd.read_parquet(FEATURES / 'rfm_features.parquet')\n", "print(f'Customers: {len(rfm):,}')\n", "rfm.head()"]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": ["## RFM Distributions"]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": ["fig, axes = __import__('matplotlib').pyplot.subplots(1, 3, figsize=(15, 4))\n", "for i, col in enumerate(['recency', 'frequency', 'monetary']):\n", "    axes[i].hist(rfm[col], bins=50)\n", "    axes[i].set_title(col.title())\n", "    axes[i].set_xlabel(col)\n", "__import__('matplotlib').pyplot.tight_layout()\n", "__import__('matplotlib').pyplot.show()"]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": ["## Segment Distribution"]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": ["seg_counts = rfm['segment'].value_counts()\n", "print(seg_counts)\n", "px.pie(values=seg_counts.values, names=seg_counts.index, title='RFM Segments')"
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": ["## Segment Profiles"]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": ["seg_stats = rfm.groupby('segment').agg(\n", "    n=('CustomerID', 'count'),\n", "    avg_recency=('recency', 'mean'),\n", "    avg_frequency=('frequency', 'mean'),\n", "    avg_monetary=('monetary', 'mean'),\n", ").round(2)\n", "seg_stats"]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": ["## RFM Scatter"]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": ["px.scatter(rfm, x='recency', y='monetary', color='segment',\n", "           size='frequency', hover_data=['CustomerID'],\n", "           title='Customer Segments (Recency vs Monetary)')"]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": ["## Clustering Quality"]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": ["import json\n", "report = json.loads((Path('..') / 'data' / 'processed' / 'segmentation_report.json').read_text())\n", "sil = report['clustering']['silhouette_scores']\n", "print(f'Best K: {report[\"clustering\"][\"best_k\"]}')\n", "print(f'Silhouette scores: {sil}')\n", "\n", "for p in report['clustering']['cluster_profiles']:\n", "    print(f'  Cluster {p[\"cluster\"]}: {p[\"n_customers\"]} customers, avg monetary=£{p[\"avg_monetary\"]:,.0f}')"]
  }
 ],
