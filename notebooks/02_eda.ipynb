{
 "cells": [
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": ["# 02 — Exploratory Data Analysis\n", "Understand revenue trends, customer behavior, products, and geography."]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": ["import pandas as pd\n", "import numpy as np\n", "import plotly.express as px\n", "from pathlib import Path\n", "\n", "PROCESSED = Path('..') / 'data' / 'processed'\n", "df = pd.read_parquet(PROCESSED / 'cleaned_retail.parquet')\n", "valid = df[(df['Revenue'] > 0) & (df['HasCustomerID'])]\n", "print(f'Valid transactions: {len(valid):,}')"]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": ["## Revenue Trends"]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": ["valid = valid.copy()\n", "valid['YearMonth'] = valid['InvoiceDate'].dt.to_period('M').astype(str)\n", "monthly = valid.groupby('YearMonth').agg(\n", "    revenue=('Revenue', 'sum'),\n", "    orders=('InvoiceNo', 'nunique'),\n", "    customers=('CustomerID', 'nunique'),\n", ").reset_index()\n", "\n", "print(f'Total Revenue: £{valid[\"Revenue\"].sum():,.0f}')\n", "print(f'Total Orders: {valid[\"InvoiceNo\"].nunique():,}')\n", "print(f'Total Customers: {valid[\"CustomerID\"].nunique():,}')\n", "print(f'AOV: £{valid.groupby(\"InvoiceNo\")[\"Revenue\"].sum().mean():,.0f}')\n", "\n", "px.bar(monthly, x='YearMonth', y='revenue', title='Monthly Revenue', labels={'revenue': 'Revenue (£)'})"
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": ["## Customer Spending Distribution"]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": ["cust_rev = valid.groupby('CustomerID')['Revenue'].sum()\n", "print(cust_rev.describe())\n", "print(f'\\nPercentiles:')\n", "for p in [50, 75, 90, 95, 99]:\n", "    print(f'  {p}th: £{np.percentile(cust_rev, p):,.0f}')\n", "px.histogram(cust_rev, nbins=50, title='Customer Total Spend Distribution')"
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": ["## Top Products"]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": ["products = valid.groupby(['StockCode', 'Description']).agg(\n", "    revenue=('Revenue', 'sum'), quantity=('Quantity', 'sum'),\n", ").reset_index().sort_values('revenue', ascending=False).head(15)\n", "\n", "px.bar(products, x='Description', y='revenue', title='Top 15 Products by Revenue')"
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": ["## Country Analysis"]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": ["country_rev = valid.groupby('Country')['Revenue'].sum().sort_values(ascending=False)\n", "uk_pct = country_rev.iloc[0] / country_rev.sum() * 100\n", "print(f'UK share of revenue: {uk_pct:.1f}%')\n", "px.bar(x=country_rev.head(10).index, y=country_rev.head(10).values, title='Top 10 Countries by Revenue')"
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": ["## Pareto Analysis"]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": ["cust_sorted = valid.groupby('CustomerID')['Revenue'].sum().sort_values(ascending=False)\n", "cumulative = cust_sorted.cumsum() / cust_sorted.sum() * 100\n", "pct_customers = np.arange(1, len(cumulative) + 1) / len(cumulative) * 100\n", "\n", "idx_80 = np.argmax(cumulative.values >= 80)\n", "print(f'{pct_customers[idx_80]:.1f}% of customers generate 80% of revenue')\n", "\n", "px.line(x=pct_customers, y=cumulative.values, title='Pareto: Customer % vs Revenue %')"
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": ["## Repeat Purchase Behavior"]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": ["orders_per_cust = valid.groupby('CustomerID')['InvoiceNo'].nunique()\n", "repeat_pct = (orders_per_cust > 1).mean() * 100\n", "print(f'Repeat buyers: {repeat_pct:.1f}%')\n", "print(f'One-time buyers: {100 - repeat_pct:.1f}%')\n", "print(f'\\nOrders per customer stats:')\n", "print(orders_per_cust.describe())"]
  }
 ],
